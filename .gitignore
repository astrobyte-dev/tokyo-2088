# Build outputs and local archives stay on this computer.
/bin/
/build/
/dist/
*.prg
*.prg.debug.xml
*.prg.settings.json
*.zip
*.tar
*.tar.gz
*.der
*.pem
*.key
*.p12
*.pfx
.env
.env.*
__pycache__/
.DS_Store
core
core.*
# Evidence is opt-in after review; raw USB/device/account records stay local.
/docs/evidence/*
!/docs/evidence/compiler-version.txt
!/docs/evidence/first-install-sanitized.json
!/docs/evidence/generic-preview-compile.sanitized.log
!/docs/evidence/generic-source-compile.sanitized.log
!/docs/evidence/generic-test-compile.sanitized.log
!/docs/evidence/historical-BUILD_AND_TEST.sanitized.md
!/docs/evidence/historical-TEST_RESULTS.sanitized.md
!/docs/evidence/installed-release-build-info.json
!/docs/evidence/java-version.txt
!/docs/evidence/native-tests-exit-code.txt
!/docs/evidence/native-tests-initial.sanitized.log
!/docs/evidence/native-tests-passed.log
!/docs/evidence/primary-build-blocker.log
!/docs/evidence/primary-build-recheck.log
!/docs/evidence/primary-debug-compile.log
!/docs/evidence/primary-device-package.sanitized.json
!/docs/evidence/primary-release-compile.log
!/docs/evidence/primary-test-compile.log
!/docs/evidence/production-memory-edge-cases.txt
!/docs/evidence/production-memory-final.png
!/docs/evidence/production-memory-final.txt
!/docs/evidence/production-memory-hobart.png
!/docs/evidence/production-memory-long-low-power.txt
!/docs/evidence/release-memory-final.txt
!/docs/evidence/release-memory.txt
!/docs/evidence/settings-after-release-restart.json
!/docs/evidence/simulator-edge-controls.json
!/docs/evidence/simulator-host-settings-close.sanitized.log
!/docs/evidence/source-state.json
!/docs/evidence/toolchain-current.sanitized.txt
!/docs/evidence/toolchain-recheck.sanitized.txt

